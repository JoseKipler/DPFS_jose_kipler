<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'NEXUS - Tecnología & Gaming' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/favico.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <% [].concat(typeof css !== 'undefined' ? css : []).forEach(file => { %>
  <link rel="stylesheet" href="/css/<%= file %>.css">
  <% }) %>
</head> 