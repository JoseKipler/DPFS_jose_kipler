<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

  <%- include('../partials/header') %>

  <main class="container">
    <section class="auth">
      <h1>Crear cuenta</h1>

      <form action="/users/register" method="POST" enctype="multipart/form-data" novalidate>

        <div class="field <%= errors.firstName ? 'field--error' : '' %>">
          <label for="firstName">Nombre</label>
          <input type="text" id="firstName" name="firstName" value="<%= old.firstName || '' %>" placeholder="Tu nombre">
          <% if (errors.firstName) { %><p class="field__error"><%= errors.firstName %></p><% } %>
        </div>

        <div class="field <%= errors.lastName ? 'field--error' : '' %>">
          <label for="lastName">Apellido</label>
          <input type="text" id="lastName" name="lastName" value="<%= old.lastName || '' %>" placeholder="Tu apellido">
          <% if (errors.lastName) { %><p class="field__error"><%= errors.lastName %></p><% } %>
        </div>

        <div class="field <%= errors.email ? 'field--error' : '' %>">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= old.email || '' %>" placeholder="tu@email.com">
          <% if (errors.email) { %><p class="field__error"><%= errors.email %></p><% } %>
        </div>

        <div class="field <%= errors.password ? 'field--error' : '' %>">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password">
          <% if (errors.password) { %>
            <p class="field__error"><%= errors.password %></p>
          <% } else { %>
            <p class="field__hint">Mínimo 8 caracteres.</p>
          <% } %>
        </div>

        <div class="field <%= errors.password2 ? 'field--error' : '' %>">
          <label for="password2">Repetir contraseña</label>
          <input type="password" id="password2" name="password2">
          <% if (errors.password2) { %><p class="field__error"><%= errors.password2 %></p><% } %>
        </div>

        <div class="field">
          <label for="image">Foto de perfil (opcional)</label>
          <input type="file" id="image" name="image" accept="image/*">
        </div>

        <div class="field <%= errors.terms ? 'field--error' : '' %>">
          <label class="check">
            <input type="checkbox" name="terms" <%= old.terms ? 'checked' : '' %>>
            <span>Acepto los <a href="#">términos y condiciones</a></span>
          </label>
          <% if (errors.terms) { %><p class="field__error"><%= errors.terms %></p><% } %>
        </div>

        <button type="submit" class="btn btn-primary">Crear cuenta</button>

        <p class="auth__alt">¿Ya tenés cuenta? <a href="/users/login">Iniciá sesión</a></p>
      </form>
    </section>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>