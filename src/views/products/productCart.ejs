<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

  <%- include('../partials/header') %>

  <main class="container">

    <h1 class="page-title">Tu carrito <span>(2 productos)</span></h1>

    <div class="cart">

      <!-- Lista de productos -->
      <section class="cart__items" aria-label="Productos del carrito">

        <article class="cart-item">
          <div class="placeholder cart-item__img">Imagen</div>

          <div class="cart-item__info">
            <h2><a href="/products/1">Nombre del producto</a></h2>
            <p class="cart-item__variant">Variante: Switch Red</p>
            <p class="cart-item__unit">$ 000.000 c/u</p>
            <button type="button" class="cart-item__remove">Eliminar</button>
          </div>

          <div class="quantity__control">
            <button type="button" aria-label="Quitar uno">−</button>
            <input type="number" value="1" min="1" aria-label="Cantidad">
            <button type="button" aria-label="Agregar uno">+</button>
          </div>

          <p class="cart-item__subtotal">$ 000.000</p>
        </article>

        <article class="cart-item">
          <div class="placeholder cart-item__img">Imagen</div>

          <div class="cart-item__info">
            <h2><a href="/products/1">Nombre del producto</a></h2>
            <p class="cart-item__variant">Variante: Negro</p>
            <p class="cart-item__unit">$ 000.000 c/u</p>
            <button type="button" class="cart-item__remove">Eliminar</button>
          </div>

          <div class="quantity__control">
            <button type="button" aria-label="Quitar uno">−</button>
            <input type="number" value="1" min="1" aria-label="Cantidad">
            <button type="button" aria-label="Agregar uno">+</button>
          </div>

          <p class="cart-item__subtotal">$ 000.000</p>
        </article>

        <div class="cart__links">
          <a href="/">‹ Seguir comprando</a>
          <button type="button" class="cart-item__remove">Vaciar carrito</button>
        </div>

      </section>

      <!-- Resumen -->
      <aside class="summary" aria-label="Resumen del pedido">
        <h2>Resumen de la compra</h2>

        <dl class="summary__rows">
          <div><dt>Subtotal</dt><dd>$ 000.000</dd></div>
          <div><dt>Descuento</dt><dd>- $ 0</dd></div>
          <div><dt>Envío</dt><dd>$ 0</dd></div>
        </dl>

        <p class="summary__total">
          <span>Total</span>
          <strong>$ 000.000</strong>
        </p>
        <p class="summary__installments">o 12 cuotas sin interés</p>

        <div class="coupon">
          <label for="cupon">Código de cupón</label>
          <div class="coupon__row">
            <input type="text" id="cupon" placeholder="Ingresá tu cupón">
            <button type="button" class="btn btn-secondary">Aplicar</button>
          </div>
        </div>

        <a href="#" class="btn btn-primary summary__buy">Iniciar compra</a>
        <p class="summary__payment">Métodos de pago: tarjeta de crédito, débito y transferencia</p>
      </aside>

    </div>

    <!-- Estado vacío: se mostrará cuando no haya productos -->
    <section class="empty">
      <h2>Tu carrito está vacío</h2>
      <p>Agregá productos para verlos acá.</p>
      <a href="/" class="btn btn-primary">Ver productos</a>
    </section>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>