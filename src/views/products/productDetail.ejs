<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

  <%- include('../partials/header') %>

  <main class="container">

    <nav class="breadcrumb" aria-label="Ubicación">
      <a href="/">Inicio</a> ›
      <a href="/products" style="text-transform: capitalize;"><%= product.category.replace(/-/g, ' ') %></a> ›
      <span><%= product.name %></span>
    </nav>

    <section class="product">

      <div class="gallery">
        <div class="placeholder gallery__main">Imagen principal</div>
        <div class="gallery__thumbs">
          <div class="placeholder">1</div>
          <div class="placeholder">2</div>
          <div class="placeholder">3</div>
        </div>
      </div>

      <div class="info">
        <h1><%= product.name %></h1>

        <div class="info__prices">
          <span class="info__price">$ <%= product.price.toLocaleString('es-AR') %></span>
        </div>
        <p class="info__installments">12 cuotas sin interés</p>
        <p class="info__stock" style="text-transform: capitalize;">Colores: <%= product.colors.join(', ') %></p>

        <div class="quantity">
          <label for="cantidad">Cantidad</label>
          <div class="quantity__control">
            <button type="button" aria-label="Quitar uno">−</button>
            <input type="number" id="cantidad" value="1" min="1">
            <button type="button" aria-label="Agregar uno">+</button>
          </div>
        </div>

        <button class="btn btn-primary info__add">Agregar al carrito</button>
        <a href="/products/cart" class="btn btn-secondary info__buy">Comprar ahora</a>
        <a href="/products/<%= product.id %>/edit" class="btn btn-secondary info__buy">Editar producto</a>
        <form action="/products/<%= product.id %>?_method=DELETE" method="POST"
              onsubmit="return confirm('¿Seguro que querés eliminar este producto?')">
          <button type="submit" class="btn btn-danger info__buy">Eliminar producto</button>
        </form>

        <ul class="info__benefits">
          <li>Envío a todo el país</li>
          <li>Garantía oficial</li>
          <li>Compra segura</li>
        </ul>
      </div>

    </section>

    <section class="section">
      <h2>Descripción</h2>
      <p class="description"><%= product.description %></p>
    </section>

    <section class="section">
      <h2>También te puede interesar</h2>
      <div class="products">
        <% related.forEach(item => { %>
          <%- include('../partials/productCard', { product: item }) %>
        <% }) %>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>