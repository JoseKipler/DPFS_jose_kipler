<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<body>

  <%- include('partials/header') %>

  <main class="container">

    <!-- Banner -->
    <section class="banner">
      <div class="banner__text">
        <h1>Subí de nivel tu setup</h1>
        <p>Los mejores periféricos y componentes, en cuotas</p>
        <a href="#" class="btn btn-primary">Ver más ofertas</a>
      </div>
      <div class="banner__img placeholder">Imagen del banner</div>
    </section>

    <!-- Categorías -->
    <section class="section">
      <h2>Categorías</h2>

      <div class="categories">
        <a href="#" class="category">
          <div class="placeholder">Imagen</div>
          <span>Teclados</span>
        </a>

        <a href="#" class="category">
          <div class="placeholder">Imagen</div>
          <span>Mouse</span>
        </a>

        <a href="#" class="category">
          <div class="placeholder">Imagen</div>
          <span>Monitores</span>
        </a>

        <a href="#" class="category">
          <div class="placeholder">Imagen</div>
          <span>Placas de video</span>
        </a>

        <a href="#" class="category">
          <div class="placeholder">Imagen</div>
          <span>Sillas</span>
        </a>
      </div>
    </section>

    <!-- Productos destacados -->
    <section class="section">
      <div class="section__head">
        <h2>Conocé nuestros productos destacados</h2>
        <a href="/products">Ver todos</a>
      </div>

      <div class="products">
        <% products.forEach(product => { %>
          <%- include('partials/productCard', { product: product }) %>
        <% }) %>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>

</body>
</html>