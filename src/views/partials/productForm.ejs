
<form id="productForm" action="<%= action %>" method="POST" enctype="multipart/form-data" novalidate>

  <div class="field <%= errors.name ? 'field--error' : '' %>">
    <label for="name">Nombre del producto</label>
    <input type="text" id="name" name="name" value="<%= values.name %>" placeholder="Ej: Teclado mecánico RGB">
    <% if (errors.name) { %>
      <p class="field__error"><%= errors.name %></p>
    <% } %>
  </div>

  <div class="field <%= errors.description ? 'field--error' : '' %>">
    <label for="description">Descripción</label>
    <textarea id="description" name="description" rows="4" placeholder="Contá de qué se trata el producto"><%= values.description %></textarea>
    <% if (errors.description) { %>
      <p class="field__error"><%= errors.description %></p>
    <% } %>
  </div>

  <!-- Campo de imagen actualizado -->
  <div class="field <%= errors.image ? 'field--error' : '' %>">
    <label for="image">Imagen (JPG, JPEG, PNG o GIF)</label>

    <% if (currentImage && currentImage !== 'default.png') { %>
      <img class="form-thumb" src="/images/products/<%= currentImage %>" alt="Imagen actual del producto">
    <% } %>

    <input type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.gif">

    <% if (errors.image) { %>
      <p class="field__error"><%= errors.image %></p>
    <% } %>
  </div>

  <div class="field <%= errors.category_id ? 'field--error' : '' %>">
    <label for="category_id">Categoría</label>
    <select id="category_id" name="category_id">
      <option value="">Elegí una categoría</option>

      <% categories.forEach(category => { %>
        <option value="<%= category.id %>" <%= values.category_id === String(category.id) ? 'selected' : '' %>>
          <%= category.name %>
        </option>
      <% }) %>
    </select>

    <% if (errors.category_id) { %>
      <p class="field__error"><%= errors.category_id %></p>
    <% } %>
  </div>

  <fieldset class="field options">
    <legend>Colores</legend>

    <% colors.forEach(color => { %>
      <label class="check">
        <input type="checkbox" name="colors" value="<%= color.id %>" <%= values.colorIds.includes(String(color.id)) ? 'checked' : '' %>>
        <span><%= color.name %></span>
      </label>
    <% }) %>
  </fieldset>

  <div class="field <%= errors.price ? 'field--error' : '' %>">
    <label for="price">Precio</label>
    <input type="number" id="price" name="price" min="0" step="1" value="<%= values.price %>" placeholder="Ej: 85000">
    <% if (errors.price) { %>
      <p class="field__error"><%= errors.price %></p>
    <% } %>
  </div>

  <button type="submit" class="btn btn-primary"><%= submitLabel %></button>

  <p class="auth__alt">
    <a href="<%= cancelUrl %>">Cancelar</a>
  </p>

</form>
