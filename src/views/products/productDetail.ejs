<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

  <%- include('../partials/header') %>

  <main class="container">

    <!-- Titulo productos -->
    <nav class="breadcrumb" aria-label="Ubicación">
      <a href="/">Inicio</a> ›
      <a href="#">Teclados</a> ›
      <span>Nombre del producto</span>
    </nav>

    <!-- Producto -->
    <section class="product">

      <div class="gallery">
        <div class="placeholder gallery__main">Imagen principal</div>
        <div class="gallery__thumbs">
          <div class="placeholder">1</div>
          <div class="placeholder">2</div>
          <div class="placeholder">3</div>
        </div>
      </div>

      <div class="info">
        <p class="info__brand">Marca del producto</p>
        <h1>Nombre del producto</h1>
        <p class="info__rating">Opiniones de compra: 4,5 de 5 (24 opiniones)</p>

        <div class="info__prices">
          <span class="info__price">$ 000.000</span>
          <span class="info__old-price">$ 000.000</span>
          <span class="info__discount">-15%</span>
        </div>
        <p class="info__installments">12 cuotas sin interés</p>
        <p class="info__stock">Stock disponible: 12 unidades</p>

        <div class="quantity">
          <label for="cantidad">Cantidad</label>
          <div class="quantity__control">
            <button type="button" aria-label="Quitar uno">−</button>
            <input type="number" id="cantidad" value="1" min="1">
            <button type="button" aria-label="Agregar uno">+</button>
          </div>
        </div>

        <button class="btn btn-primary info__add">Agregar al carrito</button>
        <a href="/products/cart" class="btn btn-secondary info__buy">Comprar ahora</a>

        <ul class="info__benefits">
          <li>Envío a todo el país</li>
          <li>Garantía oficial</li>
          <li>Compra segura</li>
        </ul>
      </div>

    </section>

    <!-- Descripción -->
    <section class="section">
      <h2>Descripción</h2>
      <p class="description">
        Acá va la descripción del producto: para qué sirve, a quién está dirigido
        y cuáles son sus principales características.
      </p>
    </section>

    <!-- Especificaciones -->
    <section class="section">
      <h2>Especificaciones</h2>
      <table class="specs">
        <tbody>
          <tr><th>Conexión</th><td>USB / Inalámbrico</td></tr>
          <tr><th>Layout</th><td>Español Latinoamérica</td></tr>
          <tr><th>Switches</th><td>Red / Blue / Brown</td></tr>
          <tr><th>Iluminación</th><td>RGB</td></tr>
          <tr><th>Garantía</th><td>12 meses</td></tr>
        </tbody>
      </table>
    </section>

    <!-- Relacionados card -->
    <section class="section">
      <h2>También te puede interesar</h2>
      <div class="products">

        <article class="card">
          <a href="/products/1">
            <div class="placeholder">Imagen del producto</div>
            <h3>Nombre del producto</h3>
          </a>
          <p class="card__price">$ 000.000</p>
          <p class="card__installments">12 cuotas sin interés</p>
          <button class="btn btn-primary">Agregar al carrito</button>
        </article>

        <article class="card">
          <a href="/products/1">
            <div class="placeholder">Imagen del producto</div>
            <h3>Nombre del producto</h3>
          </a>
          <p class="card__price">$ 000.000</p>
          <p class="card__installments">12 cuotas sin interés</p>
          <button class="btn btn-primary">Agregar al carrito</button>
        </article>

        <article class="card">
          <a href="/products/1">
            <div class="placeholder">Imagen del producto</div>
            <h3>Nombre del producto</h3>
          </a>
          <p class="card__price">$ 000.000</p>
          <p class="card__installments">12 cuotas sin interés</p>
          <button class="btn btn-primary">Agregar al carrito</button>
        </article>

      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>